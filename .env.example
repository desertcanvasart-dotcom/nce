# Copy to .env.local and fill in. Never commit real values (SEC-003).
# Railway: add the same names under the service's Variables.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "true" on production: lets search engines index the site (staging stays noindex)
ALLOW_INDEXING=false

# Supabase (staging locally; production only in Railway)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Sanity (editorial content). Project id and dataset are public identifiers; tokens are secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=auho5414
# "development" locally and on staging, "production" on the live site
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_READ_TOKEN=
# Imports only (never on Railway unless a job needs it)
SANITY_API_WRITE_TOKEN=
# Studio and schema deploys (Developer role); also a GitHub secret
SANITY_DEPLOY_TOKEN=

# Supabase CLI (applying migrations to staging); also a GitHub secret
SUPABASE_ACCESS_TOKEN=

# Development only: enables /dev/error-preview/ to test the 500 page. Never set in production.
ENABLE_DEV_ROUTES=false

# Inventory feeds (ADR-081): shared with Supabase Vault ("feed_pull_secret"); signs the scheduler's hourly pull call.
# At least 32 random characters. Without it, /api/internal/feeds/pull/ answers 503 and feeds are pulled only on approval.
FEED_PULL_SECRET=

# Booking requests answered with one tap (ADR-099).
# Signs the links in request messages (HMAC). At least 32 random characters. Without it, no request message is sent.
ACTION_LINK_SECRET=
# Resend (Faris, 21 Oct): transactional email. Without the key, messages are recorded in outbound_messages as "skipped".
RESEND_API_KEY=
# The sender, on a domain verified in Resend, e.g. "Nilecruz <requests@nilecruz.com>".
EMAIL_FROM=
# Nilecruz's team address for alerts when an operator hasn't answered in twice its reply time.
ADMIN_ALERT_EMAIL=
# WhatsApp Cloud API. Leave WHATSAPP_ENABLED=false until Meta approves the templates in docs/whatsapp-templates.md.
WHATSAPP_ENABLED=false
# A permanent system-user access token for the WhatsApp Business account.
WHATSAPP_TOKEN=
# The business phone number's ID (Meta: WhatsApp → API setup).
WHATSAPP_PHONE_NUMBER_ID=
# The Meta app secret: checks the signature on WhatsApp's webhook calls (button taps, Part B's sheets).
WHATSAPP_APP_SECRET=
# Any random string, also entered in Meta's webhook settings: answers Meta's verification request.
WHATSAPP_VERIFY_TOKEN=
