# Copy to .env.local and fill in. Never commit real values (SEC-003).
# Railway: add the same names under the service's Variables.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only "true" on production: lets search engines index the site (staging stays noindex)
ALLOW_INDEXING=false

# Supabase (staging locally; production only in Railway)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Sanity (editorial content). Project id and dataset are public identifiers; tokens are secrets.
NEXT_PUBLIC_SANITY_PROJECT_ID=auho5414
# "development" locally and on staging, "production" on the live site
NEXT_PUBLIC_SANITY_DATASET=development
SANITY_API_READ_TOKEN=
# Imports only (never on Railway unless a job needs it)
SANITY_API_WRITE_TOKEN=
# Studio and schema deploys (Developer role); also a GitHub secret
SANITY_DEPLOY_TOKEN=

# Supabase CLI (applying migrations to staging); also a GitHub secret
SUPABASE_ACCESS_TOKEN=

# Development only: enables /dev/error-preview/ to test the 500 page. Never set in production.
ENABLE_DEV_ROUTES=false
