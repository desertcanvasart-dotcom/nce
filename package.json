{
  "name": "nilecruz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tokens": "tsx scripts/tokens.ts",
    "tokens:check": "tsx scripts/tokens.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:copy": "tsx scripts/copy-lint.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "budget": "tsx scripts/bundle-budget.ts",
    "lhci": "lhci autorun",
    "ledger": "python3 -I scripts/ledger.py ../nce/nilecrz-site-silo.xlsx docs",
    "verify": "pnpm tokens:check && pnpm typecheck && pnpm lint && pnpm lint:css && pnpm lint:copy && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher",
      "@swc/core",
      "sharp"
    ]
  }
}
